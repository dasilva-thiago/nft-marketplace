# Ative a camada de simulação também no build de demonstração.
VITE_ENABLE_MOCKS=true
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=http://localhost:5173
# Cenários: default, empty, slow, out-of-order, rate-limited, unavailable.
# São determinísticos para desenvolvimento/demo; não são controles de segurança reais.
VITE_MOCK_SCENARIO=default
VITE_MOCK_DELAY_MS=0
